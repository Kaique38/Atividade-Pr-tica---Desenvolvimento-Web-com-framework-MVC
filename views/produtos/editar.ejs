<h1>Editar produto</h1>

<form action="/produtos/<%= produto.id %>" method="POST">

    <label>Nome:</label>
    <input
        type="text"
        name="nome"
        value="<%= produto.nome %>"
    >

    <br>

    <label>Preço:</label>
    <input
        type="number"
        name="preco"
        step="0.01"
        value="<%= produto.preco %>"
    >

    <br>

    <label>Quantidade:</label>
    <input
        type="number"
        name="quantidade"
        value="<%= produto.quantidade %>"
    >

    <br>

    <label>Categoria:</label>
    <select name="categoriaId" required>
        <% categorias.forEach(categoria => { %>
            <option value="<%= categoria.id %>" <%= String(produto.categoriaId) === String(categoria.id) ? 'selected' : '' %>><%= categoria.nome %></option>
        <% }) %>
    </select>
    <br>
    <button type="submit">
        Atualizar
    </button>

</form>